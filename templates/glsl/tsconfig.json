{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@suara/sdk": ["./src/sdk/index.ts"],
      "@suara/sdk/*": ["./src/sdk/*"]
    }
  },
  "include": ["src", "tests", "scripts", "cli"]
}
